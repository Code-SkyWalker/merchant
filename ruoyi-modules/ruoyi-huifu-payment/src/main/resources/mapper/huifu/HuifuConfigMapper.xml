<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.huifu.infrastructure.mapper.HuifuConfigMapper">
    <resultMap id="BaseResultMap" type="org.dromara.huifu.infrastructure.mapper.dataobject.HuifuConfigDO">
        <!--@mbg.generated-->
        <id column="huifu_id" property="huifuId"/>
        <result column="product_id" property="productId"/>
        <result column="private_key" property="privateKey"/>
        <result column="public_key" property="publicKey"/>
        <result column="type" property="type" />
        <result column="merchant_id" property="merchantId" />
    </resultMap>
    <sql id="Base_Column_List">
        huifu_id, product_id, private_key, public_key, type, merchant_id
    </sql>

    <select id="queryByMerchantId" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from tb_payment_huifu_merchant
        where merchant_id = #{merchantId}
            and type = 0    -- 商户=0
    </select>

    <select id="queryChannelConfig" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from tb_payment_huifu_merchant as merchant
        where type = 2 -- 渠道商=2
    </select>

    <select id="queryByTenantId" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from tb_payment_huifu_merchant
        where tenant_id = #{tenantId}
            and type = 1    -- 平台方=1
            and merchant_id is null
    </select>
</mapper>
