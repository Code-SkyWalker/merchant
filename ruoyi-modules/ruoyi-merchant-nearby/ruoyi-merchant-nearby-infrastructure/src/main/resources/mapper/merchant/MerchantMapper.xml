<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.merchant.infrastructure.merchant.mapper.MerchantMapper">
    <resultMap id="BaseResultMap" type="org.dromara.merchant.infrastructure.merchant.mapper.dataobject.MerchantDO">
        <!--@mbg.generated-->
        <!--@Table tb_merchant-->
        <id column="merchant_id" jdbcType="BIGINT" property="merchantId"/>
        <result column="tenant_id" jdbcType="VARCHAR" property="tenantId"/>
        <result column="merchant_code" jdbcType="VARCHAR" property="merchantCode"/>
        <result column="merchant_name" jdbcType="VARCHAR" property="merchantName"/>
        <result column="merchant_type" jdbcType="VARCHAR" property="merchantType"/>
        <result column="status" jdbcType="VARCHAR" property="status"/>
        <result column="level" jdbcType="VARCHAR" property="level"/>
        <result column="legal_person" jdbcType="VARCHAR" property="legalPerson"/>
        <result column="legal_person_id_number" jdbcType="VARCHAR" property="legalPersonIdNumber"/>
        <result column="legal_person_id_front" jdbcType="VARCHAR" property="legalPersonIdFront"/>
        <result column="legal_person_id_back" jdbcType="VARCHAR" property="legalPersonIdBack"/>
        <result column="business_license" jdbcType="VARCHAR" property="businessLicense"/>
        <result column="contact_person" jdbcType="VARCHAR" property="contactPerson"/>
        <result column="contact_phone" jdbcType="VARCHAR" property="contactPhone"/>
        <result column="contact_email" jdbcType="VARCHAR" property="contactEmail"/>
        <result column="precise_location" jdbcType="VARCHAR" property="preciseLocation"/>
        <result column="address" jdbcType="VARCHAR" property="address"/>
        <result column="outer_picture" jdbcType="VARCHAR" property="outerPicture"/>
        <result column="inner_picture" jdbcType="VARCHAR" property="innerPicture"/>
        <result column="logo" jdbcType="VARCHAR" property="logo"/>
        <result column="description" jdbcType="LONGVARCHAR" property="description"/>
        <result column="deposit_amount" jdbcType="DECIMAL" property="depositAmount"/>
        <result column="settlement_cycle" jdbcType="INTEGER" property="settlementCycle"/>
        <result column="certified" jdbcType="TINYINT" property="certified"/>
        <result column="certified_time" jdbcType="TIMESTAMP" property="certifiedTime"/>
        <result column="join_time" jdbcType="TIMESTAMP" property="joinTime"/>
        <result column="create_dept" jdbcType="BIGINT" property="createDept"/>
        <result column="create_by" jdbcType="BIGINT" property="createBy"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_by" jdbcType="BIGINT" property="updateBy"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        merchant_id,
        tenant_id,
        merchant_code,
        merchant_name,
        merchant_type,
        `status`,
        `level`,
        legal_person,
        legal_person_id_number,
        legal_person_id_front,
        legal_person_id_back,
        business_license,
        contact_person,
        contact_phone,
        contact_email,
        precise_location,
        address,
        outer_picture,
        inner_picture,
        logo,
        description,
        deposit_amount,
        settlement_cycle,
        certified,
        certified_time,
        join_time,
        create_dept,
        create_by,
        create_time,
        update_by,
        update_time
    </sql>

    <select id="selectPages" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from tb_merchant
        <where>
            <if test="qry.merchantName != null and qry.merchantName != ''">
                and merchant_name like concat('%', #{qry.merchantName}, '%')
            </if>
            <if test="qry.merchantCode != null and qry.merchantCode != ''">
                and merchant_code = #{qry.merchantCode}
            </if>
            <if test="qry.status != null">
                and `status` = #{qry.status}
            </if>
            <if test="qry.certified != null">
                and certified = #{qry.certified}
            </if>
        </where>
    </select>

    <select id="selectByUserId" resultType="org.dromara.merchant.domain.merchant.model.Merchant">
        select
        <include refid="Base_Column_List"/>
        from tb_merchant
        where create_by = #{userId}
    </select>
</mapper>
