<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.merchant.infrastructure.marketing.mapper.MarketingMapper">
  <resultMap id="BaseResultMap" type="org.dromara.merchant.infrastructure.marketing.mapper.dataobject.MarketingDO">
    <!--@mbg.generated-->
    <!--@Table tb_marketing-->
    <id column="id" property="id" />
    <result column="name" property="name" />
    <result column="receive_begin" property="receiveBegin" />
    <result column="receive_end" property="receiveEnd" />
    <result column="rules" property="rules" />
    <result column="type" property="type" />
    <result column="merchant_id" property="merchantId" />
  </resultMap>
  <sql id="Base_Column_List">
    <!--@mbg.generated-->
    id, `name`, receive_begin, receive_end, rules, `type`, merchant_id
  </sql>

<!--  <select id="queryById" resultType="org.dromara.merchant.client.marketing.dto.data.client.MarketingCO">-->
<!--      select-->
<!--      <include refid="Base_Column_List"/>-->
<!--      from tb_marketing-->
<!--      where id = #{id}-->
<!--  </select>-->




  <select id="queryPages" resultType="org.dromara.merchant.client.marketing.dto.data.client.MarketingPageCo">
      select
      <include refid="Base_Column_List"/>,
      (select count(*) from tb_marketing_spu where tb_marketing_spu.id = tb_marketing.id) as spu_count
      from tb_marketing
      <where>
          <if test="qry.name != null">
              and `name` like concat('%',#{qry.name},'%')
          </if>
          <if test="qry.type != null">
              and `type` = #{qry.type}
          </if>
          and merchant_id = #{qry.merchantId}
      </where>
    </select>


    <sql id="Join_Column_List">
        <!--@mbg.generated-->
        tb_marketing.id as tb_marketing_id,
        tb_marketing.name as tb_marketing_name,
        tb_marketing.receive_begin as tb_marketing_receive_begin,
        tb_marketing.receive_end as tb_marketing_receive_end,
        tb_marketing.rules as tb_marketing_rules,
        tb_marketing.type as tb_marketing_type,
        tb_marketing.merchant_id as tb_marketing_merchant_id
    </sql>
    <resultMap id="JoinResultMap" type="org.dromara.merchant.client.marketing.dto.data.client.MarketingCO">
        <!--@mbg.generated-->
        <id column="tb_marketing_id" property="id"/>
        <result column="tb_marketing_name" property="name"/>
        <result column="tb_marketing_receive_begin" property="receiveBegin"/>
        <result column="tb_marketing_receive_end" property="receiveEnd"/>
        <result column="tb_marketing_rules" property="rules" typeHandler="org.dromara.merchant.infrastructure.marketing.mapper.typehandler.RuleTypeHandler"/>
        <result column="tb_marketing_type" property="type"/>
        <result column="tb_marketing_merchant_id" property="merchantId"/>
    </resultMap>
    <resultMap id="selectByJoinResultMap"
               type="org.dromara.merchant.client.marketing.dto.data.client.MarketingCO"
               extends="JoinResultMap">
        <collection property="spus" ofType="org.dromara.merchant.client.marketing.dto.data.command.MarketingSpu"
                    resultMap="org.dromara.merchant.infrastructure.marketing.mapper.MarketingSpuMapper.JoinResultMap"/>
    </resultMap>
    <select id="queryById" resultMap="selectByJoinResultMap">
        select<include refid="Join_Column_List"/>,
        <include refid="org.dromara.merchant.infrastructure.marketing.mapper.MarketingSpuMapper.Join_Column_List"/>
        from tb_marketing join tb_marketing_spu on tb_marketing.id = tb_marketing_spu.marketing_id
        where tb_marketing.id = #{id}
    </select>
</mapper>
