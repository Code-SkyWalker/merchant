        <result column="tb_coupon_receive_count" property="receiveCount"/>
        <result column="tb_coupon_goods_range" property="goodsRange"/>
        <result column="tb_coupon_merchant_id" property="merchantId"/>
    </resultMap>
    <resultMap id="CouponCOJoinResultMap"
               type="org.dromara.merchant.client.marketing.dto.data.client.CouponCO"
               extends="JoinResultMap">
        <collection property="couponSpus" ofType="org.dromara.merchant.client.marketing.dto.data.command.CouponSpu"
                    resultMap="org.dromara.merchant.infrastructure.marketing.mapper.CouponSpuMapper.JoinDOResultMap"/>
    </resultMap>
    <select id="selectByCouponId" resultMap="CouponCOJoinResultMap">
        select <include refid="Join_Column_List"/>,
        <include refid="org.dromara.merchant.infrastructure.marketing.mapper.CouponSpuMapper.Join_Column_List"/>
        from tb_coupon
        left join tb_coupon_spu on tb_coupon.id = tb_coupon_spu.coupon_id
        where tb_coupon.id = #{couponId}
    </select>


    <resultMap id="CouponResultMap" type="org.dromara.merchant.domain.marketing.model.coupon.Coupon">
        <!--@mbg.generated-->
        <id column="tb_coupon_id" property="id"/>
        <result column="tb_coupon_name" property="name"/>
