        <result column="tb_coupon_merchant_id" property="merchantId"/>
    </resultMap>
    <resultMap id="CouponDomainJoinResultMap"
               type="org.dromara.merchant.domain.marketing.model.coupon.Coupon"
               extends="CouponResultMap">
        <collection property="couponSpus" ofType="org.dromara.merchant.client.marketing.dto.data.command.CouponSpu"
                    resultMap="org.dromara.merchant.infrastructure.marketing.mapper.CouponSpuMapper.JoinResultMap"/>
    </resultMap>

  <select id="selectByIdList" resultMap="CouponDomainJoinResultMap">
      select <include refid="Join_Column_List"/>,
      <include refid="org.dromara.merchant.infrastructure.marketing.mapper.CouponSpuMapper.Join_Column_List"/>
      from tb_coupon
      left join tb_coupon_spu on tb_coupon.id = tb_coupon_spu.coupon_id
      where tb_coupon.id in
      <foreach item="id" collection="couponIds" separator="," open="(" close=")">
        #{id}
      </foreach>
  </select>
</mapper>
