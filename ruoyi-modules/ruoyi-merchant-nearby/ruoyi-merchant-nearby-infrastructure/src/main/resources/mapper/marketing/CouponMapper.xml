  <resultMap id="BaseResultMap" type="org.dromara.merchant.infrastructure.marketing.mapper.dataobject.CouponDO">
    <!--@mbg.generated-->
    <!--@Table tb_coupon-->
    <id column="id" property="id" />
    <result column="name" property="name" />
    <result column="receive_begin" property="receiveBegin" />
    <result column="receive_end" property="receiveEnd" />
    <result column="service_begin" property="serviceBegin" />
    <result column="service_end" property="serviceEnd" />
    <result column="actuating_range" property="actuatingRange" />
    <result column="actuating_threshold" property="actuatingThreshold" />
    <result column="discount_type" property="discountType" />
    <result column="discount" property="discount" />
    <result column="grant_total" property="grantTotal" />
    <result column="receive_count" property="receiveCount" />
    <result column="goods_range" property="goodsRange" />
    <result column="merchant_id" property="merchantId" />
    <result column="create_dept" property="createDept" />
    <result column="create_by" property="createBy" />
    <result column="create_time" property="createTime" />
    <result column="update_by" property="updateBy" />
    <result column="update_time" property="updateTime" />
  </resultMap>
  <sql id="Base_Column_List">
    <!--@mbg.generated-->
    id, `name`, receive_begin, receive_end, service_begin, service_end, actuating_range,
    actuating_threshold, discount_type, discount, grant_total, receive_count, goods_range,
    merchant_id, tenant_id, create_dept, create_by, create_time, update_by, update_time
  </sql>

  <select id="queryPages" resultType="org.dromara.merchant.client.marketing.dto.data.client.CouponPageCO">
      select id,
             `name`,
             receive_begin,
             receive_end,
             service_begin,
             service_end,
             actuating_range,
             grant_total,
             receive_count
      from tb_coupon
      <where>
          <choose>
              <when test="qry.couponName != null">
                  name like concat('%', #{qry.couponName}, '%')
              </when>
          </choose>
          and merchant_id = #{qry.merchantId}
      </where>

  </select>

