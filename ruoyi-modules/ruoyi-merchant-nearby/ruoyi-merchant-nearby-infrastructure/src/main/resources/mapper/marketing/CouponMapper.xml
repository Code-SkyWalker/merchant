    <sql id="Join_Column_List">
        <!--@mbg.generated-->
        tb_coupon.id as tb_coupon_id,
        tb_coupon.name as tb_coupon_name,
        tb_coupon.receive_begin as tb_coupon_receive_begin,
        tb_coupon.receive_end as tb_coupon_receive_end,
        tb_coupon.service_begin as tb_coupon_service_begin,
        tb_coupon.service_end as tb_coupon_service_end,
        tb_coupon.actuating_range as tb_coupon_actuating_range,
        tb_coupon.actuating_threshold as tb_coupon_actuating_threshold,
        tb_coupon.discount_type as tb_coupon_discount_type,
        tb_coupon.discount as tb_coupon_discount,
        tb_coupon.grant_total as tb_coupon_grant_total,
        tb_coupon.receive_count as tb_coupon_receive_count,
        tb_coupon.goods_range as tb_coupon_goods_range,
        tb_coupon.merchant_id as tb_coupon_merchant_id
    </sql>
    <resultMap id="JoinResultMap" type="org.dromara.merchant.client.marketing.dto.data.client.CouponCO">
        <!--@mbg.generated-->
        <id column="tb_coupon_id" property="id"/>
        <result column="tb_coupon_name" property="name"/>
        <result column="tb_coupon_receive_begin" property="receiveBegin"/>
        <result column="tb_coupon_receive_end" property="receiveEnd"/>
        <result column="tb_coupon_service_begin" property="serviceBegin"/>
        <result column="tb_coupon_service_end" property="serviceEnd"/>
        <result column="tb_coupon_actuating_range" property="actuatingRange"/>
        <result column="tb_coupon_actuating_threshold" property="actuatingThreshold"/>
