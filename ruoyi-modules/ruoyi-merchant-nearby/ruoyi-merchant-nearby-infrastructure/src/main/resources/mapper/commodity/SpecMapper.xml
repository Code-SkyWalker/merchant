<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.merchant.infrastructure.commodity.mapper.SpecMapper">
  <resultMap id="BaseResultMap" type="org.dromara.merchant.infrastructure.commodity.mapper.dataobject.SpecDO">
    <!--@mbg.generated-->
    <!--@Table tb_spec-->
    <id column="id" property="id" />
    <result column="name" property="name" />
    <result column="options" property="options" />
    <result column="seq" property="seq" />
    <result column="template_id" property="templateId" />
  </resultMap>
  <sql id="Base_Column_List">
    <!--@mbg.generated-->
    id, `name`, `options`, seq, template_id
  </sql>

  <select id="selectPage" resultType="org.dromara.merchant.client.commodity.dto.data.clientobject.SpecPageCO">
      select <include refid="Base_Column_List"/>
      from tb_spec
      <where>
          <if test="qry.specName != null and qry.specName != ''">
              and `name` like concat('%', #{qry.specName}, '%')
          </if>
          <if test="qry.templateId != null">
              and template_id = #{qry.templateId}
          </if>
      </where>
    </select>
</mapper>
