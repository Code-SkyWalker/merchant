        select <include refid="Join_Column_List"/>,
        <include refid="org.dromara.merchant.infrastructure.commodity.mapper.SkuMapper.Join_Column_List"/>
        from tb_spu join tb_sku on tb_spu.id = tb_sku.spu_id
