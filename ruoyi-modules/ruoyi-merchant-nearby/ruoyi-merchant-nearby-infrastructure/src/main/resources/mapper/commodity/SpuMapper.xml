    <select id="selectPage" resultType="org.dromara.merchant.client.commodity.dto.data.clientobject.SpuPageCO">
        SELECT spu.id,
               spu.image,
               spu.`name`,
               (SELECT IF(
                           MIN(price) = MAX(price),
                           MIN(price),
                           CONCAT(MIN(price), ' - ', MAX(price))
                       )
                FROM tb_sku
                WHERE spu_id = spu.id)                                              AS price,
               (SELECT CONCAT_WS('/',
                                 (SELECT `name` FROM tb_category WHERE id = spu.category1_id),
                                 (SELECT `name` FROM tb_category WHERE id = spu.category2_id),
                                 (SELECT `name` FROM tb_category WHERE id = spu.category3_id))
                ) AS category_name,
               spu.is_marketable,
               spu.create_time
        FROM tb_spu spu
        <if test="qry.priceRange != null and qry.priceRange.size() == 2">
            INNER JOIN (
                SELECT spu_id 
                FROM tb_sku 
                WHERE price BETWEEN #{qry.priceRange[0]} AND #{qry.priceRange[1]}
                GROUP BY spu_id
            ) sku_filter ON spu.id = sku_filter.spu_id
        </if>
        <where>
            <if test="qry.name != null and qry.name != ''">
                and spu.`name` like concat('%', #{qry.name}, '%')
            </if>
            <if test="qry.categoryId != null">
                and spu.category3_id = #{qry.categoryId}
            </if>
            <if test="qry.createTimeRange != null and qry.createTimeRange.size() == 2">
                and spu.create_time between #{qry.createTimeRange[0]} and #{qry.createTimeRange[1]}
            </if>
            <if test="qry.marketable != null">
                and spu.is_marketable = #{qry.marketable}
            </if>
            <if test="qry.status != null">
                and spu.status = #{qry.status}
            </if>
            <if test="qry.merchantId != null">
                and spu.merchant_id = #{qry.merchantId}
            </if>
            And spu.is_delete = 0
        </where>
        ORDER BY spu.create_time DESC, spu.id ASC
    </select>


