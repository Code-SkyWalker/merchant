            order_no,
            user_id,
            user_name,
            merchant_id,
            merchant_name,
            status,
            type,
            source,
            goods_amount,
            freight_amount,
            discount_amount,
            coupon_amount,
            point_amount,
            payable_amount,
            paid_amount,
            payment_method,
            payment_order_no,
            split_confirm_no,
            split_time,
            payment_time,
            refund_order_no,
            refund_time,
            refund_amount,
            receiver_name,
            receiver_phone,
            receiver_address,
