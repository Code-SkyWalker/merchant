            ext_info,
            version,
            create_time,
            update_time,
            del_flag
    </sql>

    <resultMap id="OrderDetails_ResultMap" type="org.dromara.merchant.client.order.dto.data.clientobject.OrderCO">
        <id column="order_id" property="orderId"/>
        <result column="order_no" property="orderNo"/>
        <result column="user_id" property="userId"/>
        <result column="user_name" property="userName"/>
        <result column="merchant_id" property="merchantId"/>
        <result column="merchant_name" property="merchantName"/>
        <result column="status" property="status"/>
        <result column="type" property="type"/>
        <result column="source" property="source"/>
        <result column="goods_amount" property="goodsAmount"/>
        <result column="freight_amount" property="freightAmount"/>
        <result column="discount_amount" property="discountAmount"/>
        <result column="coupon_amount" property="couponAmount"/>
        <result column="point_amount" property="pointAmount"/>
        <result column="payable_amount" property="payableAmount"/>
        <result column="paid_amount" property="paidAmount"/>
        <result column="payment_method" property="paymentMethod"/>
        <result column="payment_time" property="paymentTime"/>
        <result column="payment_order_no" property="paymentOrderNo"/>
        <result column="refund_order_no" property="refundOrderNo"/>
        <result column="refund_time" property="refundTime"/>
        <result column="receiver_name" property="receiverName"/>
        <result column="receiver_phone" property="receiverPhone"/>
        <result column="receiver_address" property="receiverAddress"/>
        <result column="delivery_method" property="deliveryMethod"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <collection property="orderItems" ofType="org.dromara.merchant.client.order.dto.data.clientobject.OrderItemCO"
                    column="order_id"
                    select="org.dromara.merchant.infrastructure.order.mapper.OrderItemMapper.queryOrderItemCOByOrderId"/>
    </resultMap>

    <select id="queryOrderByOrderId" resultMap="OrderDetails_ResultMap">
        select <include refid="Base_Column_List"/>
        from tb_order
        where order_id = #{orderId}
    </select>

    <resultMap id="OrderPage_ResultMap" type="org.dromara.merchant.client.order.dto.data.clientobject.OrderPageCO">
        <id column="order_id" property="orderId"/>
        <result column="order_no" property="orderNo"/>
        <result column="user_id" property="userId"/>
        <result column="merchant_id" property="merchantId"/>
        <result column="merchant_name" property="merchantName"/>
        <result column="status" property="status"/>
        <result column="type" property="type"/>
        <result column="source" property="source"/>
        <result column="goods_amount" property="goodsAmount"/>
        <result column="freight_amount" property="freightAmount"/>
        <result column="discount_amount" property="discountAmount"/>
        <result column="coupon_amount" property="couponAmount"/>
        <result column="point_amount" property="pointAmount"/>
        <result column="payable_amount" property="payableAmount"/>
        <result column="paid_amount" property="paidAmount"/>
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <collection property="orderItems" ofType="org.dromara.merchant.client.order.dto.data.clientobject.OrderItemCO"
                    column="order_id"
                    select="org.dromara.merchant.infrastructure.order.mapper.OrderItemMapper.queryOrderItemByOrderId"/>
    </resultMap>

    <select id="queryOrderPage" resultMap="OrderPage_ResultMap">
        select order_id,
               order_no,
               user_id,
               merchant_id,
               merchant_name,
               status,
               type,
               source,
               goods_amount,
               freight_amount,
               discount_amount,
               coupon_amount,
               point_amount,
               payable_amount,
               paid_amount,
               create_time,
               update_time
        from tb_order
        <where>
            <choose>
                <when test="qry.userId != null">
                    `user_id` = #{qry.userId}
                </when>
                <when test="qry.username != null">
                    and `user_name` = #{qry.username}
                </when>
                <when test="qry.merchantId != null">
                    and `merchant_id` = #{qry.merchantId}
                </when>
                <when test="qry.status != null">
                    and `status` = #{qry.status}
                </when>
                <when test="qry.type != null">
                    and `type` = #{qry.type}
                </when>
                <when test="qry.source != null">
                    and `source` = #{qry.source}
                </when>
                <when test="qry.orderStartTime != null and qry.orderEndTime != null">
                    and create_time between #{qry.orderStartTime} and #{qry.orderEndTime}
                </when>
                <when test="qry.payStartTime != null and qry.payEndTime != null">
                    and payment_time between #{qry.payStartTime} and #{qry.payEndTime}
                </when>
                <when test="qry.keyword != null and qry.keyword.trim() != ''">
                    and (merchant_name like concat('%', #{qry.keyword}, '%') or
                         receiver_name = concat('%', #{qry.keyword}, '%'))
                </when>
            </choose>
        </where>
        order by create_time desc
    </select>

    <resultMap id="OrderDomainResultMap" type="org.dromara.merchant.domain.order.model.Order">
        <id column="order_id" property="orderId"/>
        <result column="order_no" property="orderNo"/>
        <result column="user_id" property="userId"/>
        <result column="merchant_id" property="merchantId"/>
        <result column="merchant_name" property="merchantName"/>
        <result column="status" property="status"/>
        <result column="type" property="type"/>
        <result column="source" property="source"/>
        <result column="goods_amount" property="goodsAmount"/>
        <result column="freight_amount" property="freightAmount"/>
        <result column="discount_amount" property="discountAmount"/>
        <result column="coupon_amount" property="couponAmount"/>
        <result column="point_amount" property="pointAmount"/>
        <result column="payable_amount" property="payableAmount"/>
        <result column="paid_amount" property="paidAmount"/>
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <collection property="orderItems" ofType="org.dromara.merchant.domain.order.model.OrderItem"
                    column="order_id"
                    select="org.dromara.merchant.infrastructure.order.mapper.OrderItemMapper.queryOrderItemByOrderId"/>
    </resultMap>

    <select id="queryById" resultMap="OrderDomainResultMap">
        select <include refid="Base_Column_List" />
        from tb_order
        where order_id = #{orderId}
    </select>

    <select id="queryByPaymentOrderId" resultMap="OrderDomainResultMap">
        select order_id,
               order_no,
               user_id,
               merchant_id,
               merchant_name,
               status,
               type,
               source,
               goods_amount,
               freight_amount,
               discount_amount,
               coupon_amount,
               point_amount,
               payable_amount,
               paid_amount,
               create_time,
               update_time
        from tb_order
        where payment_order_no = #{paymentOrderId}
    </select>
</mapper>
