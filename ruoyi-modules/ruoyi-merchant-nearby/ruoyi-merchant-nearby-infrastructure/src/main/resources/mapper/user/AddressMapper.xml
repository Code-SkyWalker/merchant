<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.merchant.infrastructure.address.mapper.AddressMapper">

    <resultMap id="Base_result_Map" type="org.dromara.merchant.infrastructure.address.mapper.dataobject.AddressDO">
        <result column="address_id" property="addressId"/>
        <result column="user_id" property="userId"/>
        <result column="receiver_name" property="receiverName"/>
        <result column="receiver_phone" property="receiverPhone"/>
        <result column="province" property="province"/>
        <result column="province_code" property="provinceCode"/>
        <result column="city" property="city"/>
        <result column="city_code" property="cityCode"/>
        <result column="district" property="district"/>
        <result column="district_code" property="districtCode"/>
        <result column="detail_address" property="detailAddress"/>
        <result column="postal_code" property="postalCode"/>
        <result column="is_default" property="isDefault"/>
        <result column="address_label" property="addressLabel"/>
        <result column="latitude" property="latitude"/>
        <result column="longitude" property="longitude"/>
    </resultMap>

    <sql id="detail">
        address_id,
        user_id,
        receiver_name,
        receiver_phone,
        province,
        province_code,
        city,
        city_code,
        district,
        district_code,
        detail_address,
        postal_code,
        is_default,
        address_label,
        latitude,
        longitude
    </sql>

    <update id="setDefault" parameterType="map">
        UPDATE user_address
        SET is_default = CASE
        WHEN is_default = 1 THEN 0 -- 原默认记录设为 0
        WHEN address_id = #{id} THEN 1 -- 新记录设为 1
        ELSE is_default -- 其他保持不变
        END
        WHERE (is_default = 1 OR address_id = #{addressId}) -- 仅更新相关行
        AND user_id = #{userId}
    </update>

    <select id="queryAddressCOById" resultType="org.dromara.merchant.client.address.dto.data.clientobject.AddressCO">
        select <include refid="detail"/>
        from tb_user_address
        where address_id = #{id}
    </select>

    <select id="queryAddressCOPages"
            resultType="org.dromara.merchant.client.address.dto.data.clientobject.AddressPageCO">
        select
        address_id,
        user_id,
        receiver_name,
        receiver_phone,
        is_default,
        address_label,
        concat(province, city, district, detail_address) as address_detail
        from tb_user_address
        where user_id = #{userId}
    </select>
</mapper>
